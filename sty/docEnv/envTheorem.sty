\ProvidesPackage{sty/docEnv/envTheorem}


\newtheorem{thm}{Theorem}

\newcommand{\mthm@printname}[1]{%
  \if\relax\detokenize{#1}\relax
  \else\ (\textit{#1})%
  \fi
}
\NewDocumentEnvironment{mtheorem}{O{} O{} o}
{%
  % #1 = manual number (optional)
  % #2 = theorem name (optional, shown in parentheses)
  % #3 = label (optional)

  \par\noindent
  \IfValueTF{#1}
    {%
      % Manual number provided → do NOT step counter
      \def\mthm@number{#1}%
    }
    {%
      % No manual number → use automatic counter
      \refstepcounter{thm}%
      \def\mthm@number{\thethm}%
    }%

  % Label handling
  \IfNoValueTF{#3}
    {\label{thm:\mthm@number}}
    {\label{#3}}%

  {\textbf{Theorem} \mthm@number\mthm@printname{#2}.}\par\noindent
}
{\par}


