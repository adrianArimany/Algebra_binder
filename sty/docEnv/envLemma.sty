\ProvidesPackage{sty/docEnv/envLemma}

\newtheorem{lem}{Lemma}

\newcommand{\mlemma@printname}[1]{%
  \if\relax\detokenize{#1}\relax
  \else\ (\textit{#1})%
  \fi
}


\NewDocumentEnvironment{mlemma}{O{} O{} o}
{%
  \par\noindent
  \IfValueTF{#1}
    {\def\mlem@number{#1}}
    {\refstepcounter{lem}\def\mlem@number{\thelem}}%

  \IfNoValueTF{#3}
    {\label{lem:\mlem@number}}
    {\label{#3}}%

  {\textbf{Lemma} \mlem@number\mthm@printname{#2}.}\par\noindent
}
{\par}


