\ProvidesPackage{sty/docEnv/envProposition}

\newtheorem{prop}{Proposition}

\newcommand{\mprop@printname}[1]{%
  \if\relax\detokenize{#1}\relax
  \else\ (\textit{#1})%
  \fi
}


\NewDocumentEnvironment{mprop}{O{} O{} o}
{%
  \par\noindent
  \IfValueTF{#1}
    {\def\mprop@number{#1}}
    {\refstepcounter{prop}\def\mprop@number{\theprop}}%

  \IfNoValueTF{#3}
    {\label{prop:\mprop@number}}
    {\label{#3}}%

  {\textbf{Proposition} \mprop@number\mthm@printname{#2}.}\par\noindent
}
{\par}


