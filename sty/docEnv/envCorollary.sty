\ProvidesPackage{sty/docEnv/envCorollary}

\makeatletter

% Counter
\newtheorem{cor}{Corollary}

% Name printer
\newcommand{\mcor@printname}[1]{%
  \if\relax\detokenize{#1}\relax
  \else\ (\textit{#1})%
  \fi
}
% Environment
\NewDocumentEnvironment{mcorollary}{O{} O{} o}
{%
  % #1 = manual number
  % #2 = name
  % #3 = label

  \par\noindent
  \IfValueTF{#1}
    {%
      % Manual number → no counter step
      \def\mcor@number{#1}%
    }
    {%
      % Automatic numbering
      \refstepcounter{cor}%
      \def\mcor@number{\thecor}%
    }%

  % Label handling
  \IfNoValueTF{#3}
    {\label{cor:\mcor@number}}
    {\label{#3}}%

  {\textbf{Corollary} \mcor@number\mcor@printname{#2}.}\par\noindent
}
{\par}

\makeatother

